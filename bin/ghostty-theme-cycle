#!/usr/bin/env bash
# Rotate the Ghostty theme to the next one in THEMES.
# Run, then press Ctrl+Shift+, in Ghostty to apply (its default reload_config keybind).
# Writes to the untracked ~/.config/ghostty/local, never to the config itself, which is
# a symlink into this repo: sed -i would replace the link with a plain file.
set -euo pipefail

LOCAL="$HOME/.config/ghostty/local"
mapfile -t THEMES < <(/snap/bin/ghostty +list-themes | sed -E 's/ \((resources|config)\)$//')

step=1
[ "${1:-}" = "--reverse" ] && step=-1

current="$(/snap/bin/ghostty +show-config | grep -oP '^theme = \K.*')"

next_index=0
count=${#THEMES[@]}
for i in "${!THEMES[@]}"; do
  if [ "${THEMES[$i]}" = "$current" ]; then
    next_index=$(( (i + step + count) % count ))
    break
  fi
done

next="${THEMES[$next_index]}"
if grep -q '^theme = ' "$LOCAL" 2>/dev/null; then
  sed -i "s/^theme = .*/theme = $next/" "$LOCAL"
else
  echo "theme = $next" >> "$LOCAL"
fi
echo "$next"
