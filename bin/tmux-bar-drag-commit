#!/usr/bin/env bash
# Commit whatever bar drag is in progress (pane pill or window pill), wherever
# the mouse was released. The only commit path: the release bindings and
# tmux-bar-drag-watchdog both call it. The drag state is read and cleared in
# one tmux command list, which tmux runs atomically, so whichever caller comes
# second finds no drag and does nothing.
set -euo pipefail

client="$1"

IFS='|' read -r src_pane insert_pane src_win insert_win drop_win drop_before < <(
  tmux display -p '#{@dragSourcePane}|#{@dragInsertBefore}|#{@dragSourceWin}|#{@dragInsertBeforeWin}|#{@paneDropWin}|#{@paneDropWinBefore}' \
    \; set -gu @dragSourcePane \; set -gu @dragInsertBefore \
    \; set -gu @dragSourceWin \; set -gu @dragInsertBeforeWin \
    \; set -gu @paneDropWin \; set -gu @paneDropWinBefore
)

if [[ -n "$src_pane" ]]; then
  pane_win="$(tmux display -p -t "$src_pane" '#{window_id}' 2>/dev/null || true)"
  if [[ -n "$pane_win" && -n "$drop_win" ]]; then
    ~/.local/bin/tmux-pane-to-window "$src_pane" join "$drop_win"
  elif [[ -n "$pane_win" && -n "$drop_before" ]]; then
    ~/.local/bin/tmux-pane-to-window "$src_pane" new "$drop_before"
  elif [[ -n "$pane_win" && -n "$insert_pane" && "$insert_pane" != "$src_pane" ]]; then
    ~/.local/bin/tmux-pane-bar-move "$pane_win" "$src_pane" "$insert_pane"
  fi
elif [[ -n "$src_win" && -n "$insert_win" && "$insert_win" != "$src_win" ]]; then
  sess="$(tmux display -p -t "$src_win" '#{session_name}' 2>/dev/null || true)"
  [[ -n "$sess" ]] && ~/.local/bin/tmux-window-bar-move "$sess" "$src_win" "$insert_win"
fi

tmux refresh-client -S -t "$client" 2>/dev/null || true
