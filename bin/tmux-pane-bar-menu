#!/usr/bin/env bash
# The pane bar's right-click menu actions that work on pill order rather than
# on tmux's own pane order: swap a pill with its left or right neighbour
# (wrapping at the ends, like swap-window does for the window bar), or split
# off a new pane whose pill lands right after this one.
set -euo pipefail

action="$1"
pane="$2"
win="$(tmux display -p -t "$pane" '#{window_id}')"

# rendering the bar heals @paneOrder first: dead panes dropped, new ones appended
~/.local/bin/tmux-pane-bar "$win" > /dev/null
read -ra ids <<< "$(tmux show -w -t "$win" -v @paneOrder)"
n=${#ids[@]}
at=-1
for i in "${!ids[@]}"; do
  [[ "${ids[$i]}" == "$pane" ]] && at=$i
done
(( at >= 0 )) || exit 0

case "$action" in
  left|right)
    (( n > 1 )) || exit 0
    if [[ "$action" == left ]]; then
      j=$(( (at - 1 + n) % n ))
    else
      j=$(( (at + 1) % n ))
    fi
    ids[$at]="${ids[$j]}"
    ids[$j]="$pane"
    tmux set -w -t "$win" @paneOrder "${ids[*]}"
    ;;
  new-after)
    new="$(tmux split-window -h -t "$pane" -c "$(tmux display -p -t "$pane" '#{pane_current_path}')" -P -F '#{pane_id}')"
    next=END
    (( at + 1 < n )) && next="${ids[$((at + 1))]}"
    ~/.local/bin/tmux-pane-bar-move "$win" "$new" "$next"
    ;;
esac
