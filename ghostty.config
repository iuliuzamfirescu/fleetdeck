font-size = 11
adjust-cell-height = -15%
theme = Purplepeter
window-decoration = true
confirm-close-surface = false

shell-integration-features = ssh-terminfo

command = tmux new-session -A -s main -c /path/to/your/project claude

# machine-specific settings, such as your own command = line, go in an untracked
# file next to this one (~/.config/ghostty/local); its values override the ones above
config-file = ?local
